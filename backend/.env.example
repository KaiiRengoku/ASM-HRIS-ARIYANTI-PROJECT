APP_NAME="ASM HRIS"
APP_ENV=local
# Kosongkan di repo. Jalankan `php artisan key:generate` setelah menyalin file ini.
APP_KEY=
# APP_DEBUG harus false di produksi — bila true, stack trace + SQL + isi env bocor tiap error.
APP_DEBUG=false
APP_URL=http://localhost:8000

# Zona waktu aplikasi — disamakan dengan jam WIB (server & MySQL = +07:00)
# agar now() PHP dan NOW() MySQL tidak berselisih ~7 jam.
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=asm_hris
DB_USERNAME=root
DB_PASSWORD=
# Offset zona waktu koneksi MySQL — offset dipakai karena tabel mysql.time_zone_name
# di server ini kosong (CONVERT_TZ nama zona gagal). +07:00 = WIB = system_time_zone server.
DB_TIMEZONE=+07:00

SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=asm_hris_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@asm-hris.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Origin frontend yang boleh memanggil API (dipisah koma). Set nilai produksi di sini.
CORS_ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

REVERB_APP_ID=asm-hris
# Ganti dengan nilai ASLI per environment sebelum produksi (key boleh publik,
# SECRET tidak). Nilai contoh ini bocor bila dipakai apa adanya — kanal WS bisa dipalsukan.
# Nilai lokal untuk dev. Frontend (frontend/src/lib/echo.ts) memakai 'asm-hris-key'
# sebagai default, jadi KEY di sini harus sama agar notifikasi real-time nyambung.
REVERB_APP_KEY=asm-hris-key
REVERB_APP_SECRET=asm-hris-secret
REVERB_HOST="0.0.0.0"
REVERB_PORT=8080
REVERB_SCHEME=http

# REVERB_HOST di atas = alamat BIND server (0.0.0.0 boleh).
# Untuk koneksi KELUAR (Laravel -> Reverb saat broadcast), jangan pakai 0.0.0.0
# (cURL error 7). Biarkan kosong agar config memakai 127.0.0.1.
REVERB_BROADCAST_HOST=127.0.0.1
REVERB_BROADCAST_PORT=8080
REVERB_BROADCAST_SCHEME=http

BROADCAST_DRIVER=reverb

BROADCAST_CONNECTION=reverb
